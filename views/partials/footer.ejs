  <!-- Footer -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-top">
        <div class="brand-logo" style="font-size: 1.15rem;">
          <picture class="logo-picture">
            <source srcset="/FathMovie.png" type="image/png">
            <img src="/FathMovie.png" alt="FathMovie Logo" class="brand-logo-img" width="26" height="26" style="width: 26px; height: 26px; border-radius: 6px;" />
          </picture>
          <span>Movie<span class="logo-tag">Nas</span></span>
        </div>
        <p class="text-xs text-slate-400">
          Platform streaming movie &amp; series modern dengan Server-Side Rendering (SSR).
        </p>
      </div>
      <div class="footer-bottom">
        <p>© 2026 FathMovie. Dipersembahkan untuk kenyamanan streaming Anda.</p>
        <p class="text-xs text-slate-500">
          Powered by Node.js, Express &amp; EJS SSR.
        </p>
      </div>
    </div>
  </footer>

  <!-- Floating 3D Bottom Navigation Dock (Home, Search, Watchlist) -->
  <% if (typeof hideNavbar === 'undefined' || !hideNavbar) { %>
  <nav class="bottom-nav-dock" id="bottomNavDock" aria-label="Navigasi Bawah">
    <div class="bottom-nav-inner">
      <a href="/" class="bottom-nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'home' ? 'active' : '' %>" id="bottomNavHome" title="Beranda">
        <div class="bottom-nav-icon">
          <i class="fa-solid fa-house"></i>
        </div>
        <span class="bottom-nav-label">Beranda</span>
      </a>

      <a href="/search" class="bottom-nav-item <%= typeof activeNav !== 'undefined' && (activeNav === 'search' || activeNav === 'movies' || activeNav === 'series') ? 'active' : '' %>" id="bottomNavSearch" title="Pencarian">
        <div class="bottom-nav-icon">
          <i class="fa-solid fa-magnifying-glass"></i>
        </div>
        <span class="bottom-nav-label">Cari</span>
      </a>

      <a href="/watchlist" class="bottom-nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'watchlist' ? 'active' : '' %>" id="bottomNavWatchlist" title="Watchlist Saya">
        <div class="bottom-nav-icon">
          <i class="fa-solid fa-bookmark"></i>
          <span class="badge-count bottom-nav-badge" style="display: none;">0</span>
        </div>
        <span class="bottom-nav-label">Watchlist</span>
      </a>
    </div>
  </nav>
  <% } %>

  <!-- Core App Scripts -->
  <script src="/js/app.js"></script>
</body>
</html>
