<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="24dp">

    <!-- Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="🎬"
            android:textSize="36sp"
            android:gravity="center"
            android:background="#1AE50914"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dukung Developer FathMovie"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ikuti channel WhatsApp kami untuk mendapatkan update terbaru, info rilisan, dan konten eksklusif seputar FathMovie! 🚀"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginBottom="20dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- WhatsApp Channel Button -->
    <LinearLayout
        android:id="@+id/btnJoinWhatsApp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#25D366"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📢"
            android:textSize="18sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ikuti Channel WhatsApp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Maybe Later Button -->
    <TextView
        android:id="@+id/btnMaybeLater"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Nanti saja"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Don't show again checkbox row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <CheckBox
            android:id="@+id/checkDontShowAgain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#E50914"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jangan tampilkan lagi"
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
