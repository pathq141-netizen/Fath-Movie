<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Play Icon Badge -->
        <FrameLayout
            android:id="@+id/btnOfflinePlayThumb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_red">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/text_white" />

        </FrameLayout>

        <!-- Video Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOfflineTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Judul Video Unduhan"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOfflineMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="Movies/FathMovie • 206.4 MB"
                android:textColor="@color/accent_gold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvOfflineDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="20 Sep 2026, 18:30"
                android:textColor="@color/text_slate"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Delete Button -->
        <ImageView
            android:id="@+id/btnOfflineDelete"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_pill_inactive"
            android:clickable="true"
            android:contentDescription="Hapus Unduhan"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/brand_red" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
